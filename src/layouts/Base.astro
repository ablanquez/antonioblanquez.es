---
/**
 * Documento base. La página entera es el «marco» del modelo de Make: mismas clases, mismo
 * contenedor (container-name: marco), así que los cortes de 600 y 1024 px caen en los mismos anchos.
 */
import "../estilos/index.css"
import "../estilos/fuentes.css"
import "../estilos/produccion.css"
import { temaInicial, temaMarco } from "../scripts/enLinea"
import { propietario } from "../datos/contenido"

interface Props {
  titulo: string
  descripcion: string
  /** Clase de página del modelo: «inicio», «proyecto», «identidad»; «legal» para las páginas legales. */
  tipo: "inicio" | "proyecto" | "identidad" | "legal"
  nombreCapa: string
  noIndexar?: boolean
  /** Imagen al compartir el enlace (Open Graph); por defecto, la de la portada. */
  imagenCompartir?: string
  /** Datos estructurados (JSON-LD) de la página, si los tiene. */
  datosEstructurados?: Record<string, unknown>
}
const { titulo, descripcion, tipo, nombreCapa, noIndexar = false, imagenCompartir = "/og-portada.png", datosEstructurados } = Astro.props
const clases = `marco con-alma color-d detalles detalles-2 detalles-3 ${tipo === "inicio" ? "inicio sitio" : `sitio ${tipo}`}`

// Una sola dirección por página (Ronda 3): sin «.html» y la portada en «/». El .htaccess redirige las demás.
const ruta = Astro.url.pathname.replace(/\.html$/, "").replace(/\/index$/, "/") || "/"
const canonica = new URL(ruta, Astro.site).href
const imagen = new URL(imagenCompartir, Astro.site).href
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    {noIndexar ? <meta name="robots" content="noindex, nofollow" /> : <link rel="canonical" href={canonica} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={propietario.nombre} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={imagen} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fuentes/ibm-plex-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline set:html={temaInicial} />
    {datosEstructurados && <script is:inline type="application/ld+json" set:html={JSON.stringify(datosEstructurados)} />}
  </head>
  <body>
    <div id="aviso-tema" class="aviso-tema" role="status"></div>
    <div class={clases} data-name={nombreCapa}><script is:inline set:html={temaMarco} /><slot /></div>
    <script>
      import "../scripts/sitio"
    </script>
  </body>
</html>
